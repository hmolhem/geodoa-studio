# Normalize text files in the repository to LF.
* text=auto eol=lf

# Windows command scripts may use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.bit binary
*.bin binary
